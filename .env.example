# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed as a reference. Settings classes read the repo-root
# `.env` and use a clear prefix per area, for example MEMORY_NEO4J_.

# Test services started by `make services-up`. Integration tests read these
# values and fall back to the same defaults when they are unset.
MEMORY_FALKORDB_HOST=localhost
MEMORY_FALKORDB_PORT=16379
MEMORY_NEO4J_URI=bolt://localhost:17687
MEMORY_NEO4J_USERNAME=neo4j
MEMORY_NEO4J_PASSWORD=memorytest123
MEMORY_PGVECTOR_DSN=postgresql://memory:memorytest123@localhost:15432/memory

# The compose file also starts a Postgres database for service state on port
# 15433. The tests that use it build their own connection string, so no
# variable is needed here. To run the service on it, set:
# MEMORY_STATE_BACKEND=postgres
# MEMORY_STATE_DSN=postgresql://memory:memorytest123@localhost:15433/memory

# Optional. Two live tests call a real model through Ollama Cloud and skip
# when no key is set. CI does not set one.
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com
